# Copy to .dev.vars and fill in for local `wrangler pages dev`. .dev.vars is
# gitignored; this file is not. Production values are set as Pages vars/secrets
# via `wrangler pages secret put` or the dashboard, never committed here.

# --- Cloudflare Access (set once the Access application exists — Phase 0) ---
# Team domain from Zero Trust > Settings > Custom Pages, e.g. "ericthomson13.cloudflareaccess.com"
CF_ACCESS_TEAM_DOMAIN=
# Application Audience (AUD) tag, shown on the Access application's Overview tab
CF_ACCESS_AUD=

# --- Local dev only (Phase 1) ---
# Access doesn't front localhost, so the API middleware needs a stand-in identity
# for `wrangler pages dev`. Never set these in production.
ENVIRONMENT=development
DEV_USER_EMAIL=you@example.com
